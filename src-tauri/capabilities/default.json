{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for AgentBoost desktop windows",
  "windows": ["*"],
  "remote": {
    "urls": [
      "https://agentboost-seven.vercel.app",
      "https://agentboost-seven.vercel.app/*"
    ]
  },
  "permissions": [
    "core:default",
    "shell:default",
    "shell:allow-open"
  ]
}