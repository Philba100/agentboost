# AgentBoost Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
# Get these from your Supabase project dashboard: https://app.supabase.com

# Public Supabase URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public Supabase Anon Key (safe to expose)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (KEEP SECRET - server-side only)
# Used for admin operations, NEVER expose to client
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =============================================================================
# STRIPE CONFIGURATION (Payment Processing)
# =============================================================================
# Get these from your Stripe Dashboard: https://dashboard.stripe.com

# Public Stripe Publishable Key (can be exposed)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51234567890abcdef...

# Stripe Secret Key (KEEP SECRET - server-side only)
STRIPE_SECRET_KEY=sk_test_51234567890abcdef...

# Stripe CLI Webhook Secret (for local testing)
# Get from: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_test_1234567890abcdef...

# Stripe Product IDs (optional, can be configured in database)
STRIPE_PRODUCT_ID_PRO=prod_Pro123456
STRIPE_PRODUCT_ID_ENTERPRISE=prod_Enterprise789

# =============================================================================
# VERCEL ANALYTICS (Optional)
# =============================================================================
# For tracking page views and performance metrics

NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your-analytics-id-here

# =============================================================================
# API CONFIGURATION
# =============================================================================

# API base URL (for development)
NEXT_PUBLIC_API_URL=http://localhost:3000

# API rate limit settings (requests per minute)
API_RATE_LIMIT=60

# OpenAI API Key for Semantic Routing
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx

# =============================================================================
# AUTHENTICATION
# =============================================================================

# JWT secret for custom tokens (if needed)
JWT_SECRET=your-super-secret-jwt-key-min-32-characters

# Session timeout (in minutes)
SESSION_TIMEOUT=30

# =============================================================================
# EMAIL CONFIGURATION (Optional)
# =============================================================================
# For sending email notifications, password resets, etc.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@agentboost.app

# =============================================================================
# ERROR TRACKING (Optional)
# =============================================================================
# For monitoring errors in production

SENTRY_DSN=https://your-key@sentry.io/project-id

# =============================================================================
# FEATURE FLAGS (Optional)
# =============================================================================

# Enable/disable features
ENABLE_STRIPE_PAYMENTS=true
ENABLE_CUSTOM_DOMAINS=false
ENABLE_WEBHOOKS=true
ENABLE_EMAIL_NOTIFICATIONS=true

# =============================================================================
# LOGGING
# =============================================================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# =============================================================================
# ENVIRONMENT
# =============================================================================

# development, staging, or production
NODE_ENV=development

# Next.js environment
NEXT_ENV=development
